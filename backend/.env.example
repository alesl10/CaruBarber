# Copiar a .env y ajustar (dev local)
PORT=3001

# --- Base de datos ---
# Dev local: si NO hay DATABASE_URL, usa SQLite en este archivo.
DB_FILE=turnero.db
# Producción (Supabase / cualquier Postgres): connection string.
# En Vercel usar el "Connection pooler" de Supabase (Transaction, puerto 6543):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# El esquema se crea una vez con `npm run schema:sync` (ver DEPLOY.md), así que dejar en false.
DB_SYNC=false
DB_SSL=true
DB_POOL_MAX=2
# false = no cargar los datos demo al arrancar
SEED_ON_BOOT=true

# --- Auth ---
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES=7d

# --- URLs ---
# Orígenes permitidos para CORS (coma). En prod: la URL del frontend en Vercel.
FRONTEND_URL=http://localhost:3000
# URL pública del frontend para armar los links de los emails.
PUBLIC_APP_URL=http://localhost:3000
ACCION_LINK_EXPIRES=45d

# --- Email (nodemailer) ---
# Dev sin SMTP: cuenta de prueba Ethereal (link de preview en consola).
# Prod sin SMTP: emails desactivados.
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#   SMTP_USER=tu@gmail.com, SMTP_PASS=<app password de 16 caracteres>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Caru Barber <no-reply@tudominio.com>
PELUQUERO_EMAIL=

# --- WhatsApp (Twilio) — DESACTIVADO ---
# Ver el instructivo al pie de src/notificaciones/notificador.service.ts.
# PELUQUERO_WHATSAPP=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
